<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back">

    <!-- ================= MAIN CONTENT ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Back Button -->

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Go back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/dark" />

            <!-- Header Text -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Pets 🐾"
                    android:textColor="@color/dark"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.65"
                    android:text="Manage your lovely companions"
                    android:textColor="@color/dark"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================= SEARCH BAR ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/main_background"
            app:cardCornerRadius="27dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/input_broder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="17dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary" />

                <EditText
                    android:id="@+id/etSearchPets"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search your pets..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/dark"
                    android:textColorHint="@color/grey"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnFilterPets"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_filter_button"
                    android:contentDescription="Filter pets"
                    android:padding="10dp"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================= SECTION HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Pets"
                android:textColor="@color/dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPetCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 pets"
                android:textColor="@color/grey"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================= PET LIST ================= -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/petContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="100dp">

                <!-- ================= PET CARD ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPet"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/input_background"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/input_broder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <!-- Pet Image -->

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            app:cardBackgroundColor="@color/input_background"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/imgPet"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Pet photo"
                                android:scaleType="centerCrop"
                                android:src="@drawable/dog" />

                        </com.google.android.material.card.MaterialCardView>


                        <!-- Pet Information -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPetName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Buddy 🐾"
                                android:textColor="@color/dark"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBreed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Golden Retriever"
                                android:textColor="@color/dark"
                                android:alpha="0.70"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvAge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="2 Years Old  •  Male"
                                android:textColor="@color/grey"
                                android:textSize="13sp" />

                        </LinearLayout>


                        <!-- View Details Button -->

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/input_background"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/input_broder"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/ivViewPet"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="View pet details"
                                android:padding="10dp"
                                android:src="@drawable/arrow_right"
                                app:tint="@color/primary" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= EMPTY STATE ================= -->

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:gravity="center"
                    android:text="No pets added yet.\nTap + to add your first pet 🐾"
                    android:textColor="@color/grey"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ================= FLOATING ADD PET BUTTON ================= -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddPet"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Add New Pet"
        android:src="@drawable/ic_add"
        android:tint="@android:color/white"
        app:backgroundTint="@color/primary"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        app:maxImageSize="28dp"
        app:rippleColor="#33FFFFFF"
        app:useCompatPadding="true" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>


<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    android:fillViewport="true"
    tools:context=".OtpVerification">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingTop="55dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- OTP Icon -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="OTP Verification"
            android:scaleType="centerInside"
            android:src="@drawable/otp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Verify OTP"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="We've sent a 6-digit OTP to"
            android:textColor="#7A8494"
            android:textSize="15sp" />

        <!-- Phone Number -->
        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+977 XXXXX XXXXX"
            android:textColor="#172033"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- OTP Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- OTP 1 -->
            <EditText
                android:id="@+id/otp1"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/otp_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- OTP 2 -->
            <EditText
                android:id="@+id/otp2"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/otp_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- OTP 3 -->
            <EditText
                android:id="@+id/otp3"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/otp_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- OTP 4 -->
            <EditText
                android:id="@+id/otp4"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/otp_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- OTP 5 -->
            <EditText
                android:id="@+id/otp5"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/otp_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- OTP 6 -->
            <EditText
                android:id="@+id/otp6"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:background="@drawable/otp_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Clear OTP -->
        <TextView
            android:id="@+id/tvClearOTP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Clear OTP"
            android:textColor="@color/dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- OTP Timer -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="OTP expires in 01:00"
            android:textColor="#7A8494"
            android:textSize="14sp" />

        <!-- Verify OTP Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyOTP"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Verify OTP"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp" />

        <!-- Resend OTP -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't receive OTP? "
                android:textColor="#7A8494"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvResendOTP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Resend OTP"
                android:textColor="@color/dark"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
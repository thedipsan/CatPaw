<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none"
    tools:context=".OtpVerification">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="40dp">


        <!-- ================================================= -->
        <!-- OTP ILLUSTRATION                                  -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="75dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EAF7F4"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_gravity="center"
                android:src="@drawable/otp"
                android:scaleType="centerInside"
                android:contentDescription="OTP Verification" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TITLE                                             -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Verify OTP"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />


        <!-- ================================================= -->
        <!-- DESCRIPTION                                       -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:text="We've sent a 6-digit verification code to"
            android:textColor="#7A8494"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />


        <!-- ================================================= -->
        <!-- PHONE NUMBER                                      -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="+977 XXXXX XXXXX"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />


        <!-- ================================================= -->
        <!-- OTP INPUT AREA                                    -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E8ECF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingTop="17dp"
                android:paddingEnd="15dp"
                android:paddingBottom="17dp">


                <!-- OTP Label -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter verification code"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="3dp" />


                <!-- ================================================= -->
                <!-- OTP BOXES                                          -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <!-- OTP 1 -->

                    <EditText
                        android:id="@+id/otp1"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/otp_background"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:padding="0dp"
                        android:textColor="#172033"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:importantForAutofill="no"
                        android:selectAllOnFocus="true" />


                    <!-- OTP 2 -->

                    <EditText
                        android:id="@+id/otp2"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/otp_background"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:padding="0dp"
                        android:textColor="#172033"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:importantForAutofill="no"
                        android:selectAllOnFocus="true" />


                    <!-- OTP 3 -->

                    <EditText
                        android:id="@+id/otp3"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/otp_background"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:padding="0dp"
                        android:textColor="#172033"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:importantForAutofill="no"
                        android:selectAllOnFocus="true" />


                    <!-- OTP 4 -->

                    <EditText
                        android:id="@+id/otp4"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/otp_background"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:padding="0dp"
                        android:textColor="#172033"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:importantForAutofill="no"
                        android:selectAllOnFocus="true" />


                    <!-- OTP 5 -->

                    <EditText
                        android:id="@+id/otp5"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/otp_background"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:padding="0dp"
                        android:textColor="#172033"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:importantForAutofill="no"
                        android:selectAllOnFocus="true" />


                    <!-- OTP 6 -->

                    <EditText
                        android:id="@+id/otp6"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/otp_background"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:padding="0dp"
                        android:textColor="#172033"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:importantForAutofill="no"
                        android:selectAllOnFocus="true" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- CLEAR OTP                                         -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/tvClearOTP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="13dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Clear OTP"
                    android:textColor="@color/dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TIMER                                              -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="OTP expires in 01:00"
            android:textColor="#7A8494"
            android:textSize="13sp"
            android:gravity="center" />


        <!-- ================================================= -->
        <!-- VERIFY BUTTON                                     -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyOTP"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="23dp"
            android:text="Verify OTP"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:rippleColor="#30FFFFFF" />


        <!-- ================================================= -->
        <!-- RESEND OTP                                        -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't receive OTP? "
                android:textColor="#7A8494"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvResendOTP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Resend OTP"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SECURITY MESSAGE                                  -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#EAF7F4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Your verification is secure"
                android:textColor="#8A93A2"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
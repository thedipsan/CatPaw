<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/back"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">


        <!-- ================================================= -->
        <!-- OTP ILLUSTRATION                                  -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="75dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EAF7F4"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_gravity="center"
                android:src="@drawable/otp"
                android:scaleType="centerInside"
                android:contentDescription="Phone verification" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TITLE                                             -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Phone Verification"
            android:textColor="#172033"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />


        <!-- ================================================= -->
        <!-- DESCRIPTION                                       -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:text="Enter your phone number and we'll send you a verification code"
            android:textColor="#7A8494"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />


        <!-- ================================================= -->
        <!-- PHONE INPUT CARD                                  -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E7EBEF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">




                <!-- Phone Number -->

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="#172033"
                    android:textColorHint="#A5AFBE"
                    android:textSize="15sp"
                    android:importantForAutofill="yes" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- HELPER TEXT                                       -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:paddingStart="5dp"
            android:text="We'll use this number to verify your account."
            android:textColor="#98A1AE"
            android:textSize="12sp" />


        <!-- ================================================= -->
        <!-- SEND OTP BUTTON                                   -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendOTP"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Send OTP"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:rippleColor="#30FFFFFF" />


        <!-- ================================================= -->
        <!-- SECURITY MESSAGE                                  -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#EAF7F4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Your information is secure"
                android:textColor="#7A8494"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FC">

    <!-- ================================================= -->
    <!-- MAIN CONTENT                                      -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ================================================= -->
            <!-- HEADER                                             -->
            <!-- ================================================ = -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi, PawMate User 👋"
                        android:textColor="#172033"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Take care of your furry friend ❤️"
                        android:textColor="#7A8494"
                        android:textSize="14sp"
                        android:includeFontPadding="false" />

                </LinearLayout>


                <!-- Notification Button -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E8EAF0"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageButton
                        android:id="@+id/btnNotification"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:padding="12dp"
                        android:src="@drawable/notification"
                        android:scaleType="centerInside"
                        android:contentDescription="Notifications" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PET PROFILE                                       -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPet"
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:layout_marginTop="22dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#EAF7F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="17dp">

                    <!-- ================================================= -->
                    <!-- PET IMAGE - UNCHANGED                              -->
                    <!-- ================================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgPet"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/dog"
                            android:scaleType="centerCrop"
                            android:contentDescription="Pet image" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- Pet Information -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPetName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buddy 🐾"
                            android:textColor="#172033"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tvPetInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Golden Retriever • 2 Years"
                            android:textColor="#6E7888"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewPet"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:minWidth="0dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="View Profile"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="12dp"
                            app:elevation="0dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- TODAY'S PROGRESS - NEW                            -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E9EDF1"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="17dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="17dp">


                    <!-- ========================================= -->
                    <!-- LEFT CONTENT                               -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today's Progress"
                            android:textColor="#172033"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />


                        <!-- Progress Count -->

                        <TextView
                            android:id="@+id/tvProgressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="0 / 0"
                            android:textColor="#172033"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />


                        <!-- Progress Description -->

                        <TextView
                            android:id="@+id/tvProgressSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tasks completed"
                            android:textColor="#7A8494"
                            android:textSize="12sp"
                            android:includeFontPadding="false" />

                    </LinearLayout>


                    <!-- ========================================= -->
                    <!-- CIRCULAR PROGRESS                          -->
                    <!-- ========================================= -->

                    <FrameLayout
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:layout_marginStart="12dp"
                        android:gravity="center">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressToday"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:max="100"
                            android:progress="0"
                            app:indicatorSize="76dp"
                            app:indicatorInset="3dp"
                            app:trackThickness="7dp"
                            app:trackColor="#E9F2EE"
                            app:indicatorColor="@color/primary"
                            app:indicatorDirectionCircular="clockwise" />


                        <!-- Percentage -->

                        <TextView
                            android:id="@+id/tvProgressPercent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="0%"
                            android:textColor="#172033"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- TODAY'S CARE                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today's Care"
                    android:textColor="#172033"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CARE CARDS                                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">


                <!-- ================= FEEDING ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeeding"
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EEF0F4"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="🍖"
                            android:textSize="25sp"
                            android:background="#FFF4E8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Feeding"
                            android:textColor="#172033"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFeedingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Completed"
                            android:textColor="#55A889"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= EXERCISE ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExercise"
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EEF0F4"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="🏃"
                            android:textSize="25sp"
                            android:background="#EEF7FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Exercise"
                            android:textColor="#172033"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvExerciseStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Pending"
                            android:textColor="#E49A43"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= MEDICINE ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMedicine"
                    android:layout_width="0dp"
                    android:layout_height="125dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EEF0F4"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="💊"
                            android:textSize="25sp"
                            android:background="#F5EEFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Medicine"
                            android:textColor="#172033"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMedicineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="2:00 PM"
                            android:textColor="#7A8494"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- QUICK ACTIONS                                     -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:text="Quick Actions"
                android:textColor="#172033"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- ================= MY PETS ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyPets"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEF0F4"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="🐶"
                        android:textSize="23sp"
                        android:background="#EEF8F6" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="My Pets"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#8A93A2"
                        android:textSize="27sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= VET APPOINTMENTS ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAppointments"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="9dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEF0F4"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="🩺"
                        android:textSize="23sp"
                        android:background="#FFF4F2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Vet Appointments"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#8A93A2"
                        android:textSize="27sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= REMINDERS ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReminders"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEF0F4"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <TextView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="🔔"
                        android:textSize="23sp"
                        android:background="#FFF8E8" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Reminders"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#8A93A2"
                        android:textSize="27sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- BOTTOM NAVIGATION                                 -->
    <!-- ================================================= -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation" />

</LinearLayout>
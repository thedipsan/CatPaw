<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/back"

    tools:context=".PasswordSuccess">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="70dp"
        android:paddingBottom="40dp">

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/imgSuccess"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:src="@drawable/successful"
            android:scaleType="centerInside"
            android:contentDescription="Password updated successfully" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Password Updated!"
            android:textColor="#172033"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvSuccessMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="Your password has been reset successfully."
            android:textColor="#7A8494"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <!-- Extra Message -->
        <TextView
            android:id="@+id/tvLoginMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="You can now login using your new password."
            android:textColor="#7A8494"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- Back To Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="35dp"

            android:text="Back to Login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"

            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            app:elevation="2dp" />

    </LinearLayout>

</ScrollView>
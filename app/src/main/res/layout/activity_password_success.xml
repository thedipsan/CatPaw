<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/back"
    android:clipToPadding="false"
    android:scrollbars="none"

    tools:context=".PasswordSuccess">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="45dp">


        <!-- SUCCESS ILLUSTRATION                              -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="20dp"

            app:cardCornerRadius="85dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EAF7F4"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgSuccess"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:layout_gravity="center"
                android:src="@drawable/successful"
                android:scaleType="centerInside"
                android:contentDescription="Verification successful" />

        </com.google.android.material.card.MaterialCardView>


        <!-- SUCCESS TITLE                                     -->

        <TextView
            android:id="@+id/tvSuccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="Verified Successfully!"
            android:textColor="#172033"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />


        <!-- SUCCESS MESSAGE                                   -->

        <TextView
            android:id="@+id/tvSuccessMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="11dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"

            android:text="Your OTP has been verified successfully."
            android:textColor="#7A8494"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp" />


        <!-- HOME MESSAGE CARD                                 -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="23dp"

            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E8ECF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">


                <!-- Success Check -->

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"

                    android:text="✓"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"

                    android:background="#EAF7F4" />


                <!-- Message -->

                <TextView
                    android:id="@+id/tvHomeMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:layout_marginStart="12dp"

                    android:text="Your account has been successfully verified. You can now continue to the home page."
                    android:textColor="#667181"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- BACK TO HOME BUTTON                               -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="25dp"

            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"

            app:backgroundTint="@color/primary"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:rippleColor="#30FFFFFF" />


        <!-- SECURITY MESSAGE                                  -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"

                android:gravity="center"

                android:text="✓"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"

                android:background="#EAF7F4" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"

                android:text="Your account is secure"
                android:textColor="#8A93A2"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>